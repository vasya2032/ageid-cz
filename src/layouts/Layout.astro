---
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content="Zero-data client-side validator for eIDAS 2.0, SD-JWT (RFC 9535), and OpenID4VP." />
  </head>
  <body class="bg-[#09090b] text-zinc-100 antialiased selection:bg-zinc-800">
    <slot />
  </body>
</html>